# Supabaseプロジェクトの設定(Supabaseダッシュボード > Project Settings > API から取得)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 確認メールのリンク遷移先(末尾スラッシュなし)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# デプロイする試験。未設定時は hygiene
# 有効値: hygiene | boiler2 | crane_all | mobile_crane | xray | diver | pressure_chamber
NEXT_PUBLIC_EXAM_ID=hygiene

# Cloudflare Turnstile のサイトキー(ダッシュボードのウィジェットから取得)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_ANONYMOUS_SITE_KEY=

# サーバー側のみで使う秘密鍵(絶対にクライアントに露出させないこと)
SUPABASE_SERVICE_ROLE_KEY=
