# Supabaseプロジェクトの設定(Supabaseダッシュボード > Project Settings > API から取得)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 確認メールのリンク遷移先(末尾スラッシュなし)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# デプロイする試験。未設定時は hygiene
# 有効値: hygiene | boiler2 | crane_all | mobile_crane | xray | diver | pressure_chamber | cargo_gear
NEXT_PUBLIC_EXAM_ID=hygiene

# Cloudflare Turnstile のサイトキー(ダッシュボードのウィジェットから取得)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_TURNSTILE_ANONYMOUS_SITE_KEY=

# サーバー側のみで使う秘密鍵(絶対にクライアントに露出させないこと)
SUPABASE_SERVICE_ROLE_KEY=

# Google AdSense のパブリッシャーID（例: pub-1234567890123456）
# 未設定または形式不正の場合、/ads.txt は404を返します
ADSENSE_PUBLISHER_ID=

# Google AdSense のクライアントID（例: ca-pub-1234567890123456）
# 本番環境（NODE_ENV=production）でのみ所有権確認スクリプトの読み込みに使用されます
NEXT_PUBLIC_ADSENSE_CLIENT=
